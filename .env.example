# Site Configuration
# SITE_URL=https://opendesk-edu.org
# SITE_NAME=openDesk Edu
# SITE_DESCRIPTION=Educational digital infrastructure for universities - openDesk CE with 15 integrated services for seamless digital transformation.
# PLAUSIBLE_DOMAIN=opendesk-edu.org

# Analytics
# NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id

# Deployment (production only)
# DEPLOY_HOST=opendesk-edu.org
# DEPLOY_USER=weiss
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_PATH=/home/weiss/git/next-opendesk-edu-org

# Contact form SMTP
# Required for contact form to work
# SMTP_HOST=mailcowdockerized-postfix-mailcow-1
# SMTP_PORT=587
# SMTP_USER=info@opendesk-edu.org
# SMTP_PASS=your-smtp-password
# CONTACT_RECIPIENT=info@opendesk-edu.org

# Newsletter (SQLite - local database)
# Newsletter subscriptions are stored in data/newsletter.db
# No external service required.
# For listmonk integration (optional):
# LISTMONK_URL=http://listmonk:9000
# LISTMONK_API_KEY=your-listmonk-api-key
# LISTMONK_LIST_ID=1

# Deploy notifications (ntfy.sh - optional)
# NTFY_TOPIC=your-ntfy-topic